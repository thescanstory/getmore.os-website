{
  "name": "getmoreos-website",
  "version": "1.0.0",
  "description": "GetMoreOS - Growth Engine & PitchFinder for Local Businesses",
  "main": "index.html",
  "type": "module",
  "scripts": {
    "start": "node scripts/serve.js",
    "dev": "node scripts/serve.js",
    "test": "node --test tests/unit/*.test.js",
    "test:simulate": "node tests/simulation/synthetic_traffic.js",
    "audit": "node tests/unit/seo_and_schema.test.js && node tests/unit/links_and_assets.test.js",
    "supervisor": "node tests/supervisor.js",
    "build:css": "tailwindcss -i input.css -o style.css --minify",
    "build": "npm run build:css && node scripts/build_check.js"
  },
  "keywords": [
    "getmoreos",
    "local-business",
    "pitchfinder",
    "whatsapp-automation",
    "growth"
  ],
  "author": "GetMoreOS Team",
  "license": "UNLICENSED",
  "devDependencies": {
    "puppeteer-core": "^25.13.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.19"
  }
}
